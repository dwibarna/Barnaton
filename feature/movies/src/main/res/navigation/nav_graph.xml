<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.labs.barnaton.feature.movies.ui.home.HomeFragment"
        android:label="@string/title_genres">
        <action
            android:id="@+id/action_home_to_movie_list"
            app:destination="@id/movieListFragment" />
        <action
            android:id="@+id/action_home_to_movie_detail"
            app:destination="@id/movieDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/movieListFragment"
        android:name="com.labs.barnaton.feature.movies.ui.movies.MovieListFragment"
        android:label="{genreName}">
        <argument
            android:name="genreId"
            app:argType="integer" />
        <argument
            android:name="genreName"
            app:argType="string" />
        <action
            android:id="@+id/action_movie_list_to_movie_detail"
            app:destination="@id/movieDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/movieDetailFragment"
        android:name="com.labs.barnaton.feature.movies.ui.detail.MovieDetailFragment"
        android:label="{movieTitle}">
        <argument
            android:name="movieId"
            app:argType="integer" />
        <argument
            android:name="movieTitle"
            app:argType="string" />
        <action
            android:id="@+id/action_movie_detail_to_reviews"
            app:destination="@id/reviewsFragment" />
    </fragment>

    <fragment
        android:id="@+id/reviewsFragment"
        android:name="com.labs.barnaton.feature.movies.ui.reviews.ReviewsFragment"
        android:label="{movieTitle}">
        <argument
            android:name="movieId"
            app:argType="integer" />
        <argument
            android:name="movieTitle"
            app:argType="string" />
    </fragment>

</navigation>
