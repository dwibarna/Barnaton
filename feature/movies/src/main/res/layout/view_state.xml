<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressIndicator"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminate="true"
            app:indicatorColor="@color/brand_primary"
            app:indicatorSize="36dp"
            app:trackThickness="3dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvLoadingMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_loading"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/outline_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <FrameLayout
                android:id="@+id/iconBadgeContainer"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_state_icon_circle">

                <ImageView
                    android:id="@+id/ivStateIcon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_state_icon"
                    tools:src="@drawable/ic_error_outline" />
            </FrameLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvStateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                tools:text="No Internet Connection" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvStateMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/text_secondary"
                tools:text="Please check your network connection and try again." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="28dp"
                android:text="@string/action_retry"
                android:textColor="@color/brand_on_primary"
                android:visibility="gone"
                app:backgroundTint="@color/brand_primary"
                app:cornerRadius="12dp"
                tools:visibility="visible" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</merge>
